# Betriebsmodus: "memory" (mitgelieferter Graph-Mock) oder "graph" (echter Tenant)
GRAPH_MODE=memory

# Nur für GRAPH_MODE=graph: App-Registrierung in Entra ID (Client-Credentials-Flow)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Namenskonvention der Schule
UPN_DOMAIN=gymnasium-boeblingen.de
USAGE_LOCATION=DE

# DSGVO / Governance
LEAVER_RETENTION_DAYS=30
INACTIVITY_THRESHOLD_DAYS=90

# Fixer Stichtag für reproduzierbare Demos/Tests. Für Produktion leer lassen ("").
REFERENCE_DATE=2026-07-23
